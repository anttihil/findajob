# =====================================================================
# CareerRadar Environment Configuration
# =====================================================================

# DeepSeek API key: optional if an authenticated CLI provider (agy, claude, codex) is installed;
# required if using direct API mode or running in Docker.
DEEPSEEK_API_KEY=sk-...

# Optional: Tavily API key for company web research and contact discovery

# Optional: Rotating proxy pool (required for full LinkedIn description scrapes)
# Format: "user:pass@host:port" or "user:pass@host1:port,user:pass@host2:port"
# SCRAPER_PROXIES=

# Optional: Tailscale login permitted to access the dashboard
# Leave blank for unrestricted local access (127.0.0.1)
# CAREERRADAR_OWNER=user@github

# Optional: Opt-in authentication for remote/Docker/VPS deployments
# Protects the dashboard with HTTP Basic Auth and Bearer Token / API Key validation
# CAREERRADAR_PASSWORD=your_secure_password
# CAREERRADAR_USER=admin
# CAREERRADAR_AUTH_TOKEN=your_custom_api_token

# Optional: Custom application log file path (defaults to ./app.log)
# CAREERRADAR_LOG_PATH=./app.log

