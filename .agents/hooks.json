{
  "lint-checker": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/check_ruff.py || python3 .agents/hooks/check_ruff.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "type-checker": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/check_pyright.py || python3 .agents/hooks/check_pyright.py",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "eslint-checker": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/check_eslint.py || python3 .agents/hooks/check_eslint.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
