{
  "description": "Run the project's static checks after Codex edits source files.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/check_modified_files.py\"",
            "timeout": 90,
            "statusMessage": "Running Ruff, Pyright, and ESLint..."
          }
        ]
      }
    ]
  }
}
