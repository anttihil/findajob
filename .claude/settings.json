{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/verify_stop.py\"",
            "timeout": 600,
            "statusMessage": "Checking changed files and verification freshness..."
          }
        ]
      }
    ]
  }
}
