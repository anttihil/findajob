[Unit]
Description=CareerRadar dashboard
Documentation=file:///opt/careerradar/README.md
After=network-online.target
Wants=network-online.target

# Bound the damage from a crash loop: give up after 5 restarts in 5 minutes rather than
# hammering a genuinely broken build forever. These belong in [Unit], not [Service] --
# systemd parses them here and silently ignores them there.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec

# System unit, not a user unit. A home server should serve the dashboard from boot without
# anyone logging in, which would otherwise need `loginctl enable-linger`; and only a system
# unit can actually order itself after network-online.target, which does not exist in the
# user manager.
User=careerradar
Group=careerradar

WorkingDirectory=/opt/careerradar

# uvicorn is invoked directly rather than through `careerradar web --reload`: the reload
# watcher kills the server on any edit under the tree and forks a reloader child that
# confuses systemd's process tracking. The CLI stays the development entry point.
#
# The module path is `careerradar.web.app:app`. It was `backend.main:app` until the
# package reorganization moved it, and because `backend/` still holds a __pycache__ the
# breakage looked like an import error rather than a missing directory.
#
# The venv interpreter is invoked directly rather than through `uv run`, so a boot-time
# start cannot block on dependency resolution or a network round trip.
#
# Port 8010, not 8000: the host already runs another FastAPI app on 8000, which owns
# https://<host>.ts.net/ at the tailnet root. This one is reached on :9443 instead --
# see README, Deployment.
ExecStart=/opt/careerradar/.venv/bin/uvicorn \
    careerradar.web.app:app --host 127.0.0.1 --port 8010

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=careerradar-web

# The dashboard only ever reads the repo and writes the database beside it.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/opt/careerradar

[Install]
WantedBy=multi-user.target
