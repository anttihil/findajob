[Unit]
Description=CareerRadar search: scrape job boards
Documentation=file:///opt/careerradar/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# System unit, not a user unit -- see careerradar-web.service for why.
User=careerradar
Group=careerradar

WorkingDirectory=/opt/careerradar
ExecStart=/opt/careerradar/.venv/bin/careerradar search run

# A run is scrape-bound, not CPU-bound: LinkedIn spends ~1.6s per description and a full
# 12-search budget is ~17 minutes. The ceiling is generous so a slow-but-healthy run is
# never killed mid-cell, which would leave the cell's observation unwritten.
TimeoutStartSec=45min

# Deliberately absent: Restart=. A failed scrape must NOT be retried automatically -- the
# circuit breaker already decided how long to back off, and restarting the unit would
# discard that decision and re-approach a board that just rate-limited us.
#
# This unit no longer scores anything. Postings land as pipeline_state='new' and
# careerradar-score.timer drains them, so a board outage costs a scrape and nothing else.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=careerradar-search

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/opt/careerradar
