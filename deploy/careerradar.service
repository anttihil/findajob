[Unit]
Description=CareerRadar Dashboard and Background Scheduler
Documentation=https://github.com/example/careerradar
After=network-online.target
Wants=network-online.target

# Bound the damage from a crash loop: give up after 5 restarts in 5 minutes
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec

User=careerradar
Group=careerradar

WorkingDirectory=/opt/careerradar

# Ensure user-installed CLI binaries (agy, claude, codex) are discovered in PATH
Environment="PATH=/home/careerradar/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Invokes the unified entry point: serves FastAPI dashboard and runs asyncio background scheduler
ExecStart=/opt/careerradar/.venv/bin/careerradar start --host 127.0.0.1 --port 8010

Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=careerradar

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/opt/careerradar

[Install]
WantedBy=multi-user.target
