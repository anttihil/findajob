# Install as /etc/logrotate.d/careerradar (root-owned, mode 0644).
#
# The application no longer rotates its own log. Four units write app.log at the same time
# and each holds the inode open for the life of the process, so a rename-based rotation
# leaves three of them appending to a file the next rotation deletes.
#
# copytruncate is the point of this file: it copies the contents and truncates the original
# in place, so every open handle keeps writing to the same inode. The cost is a race -- lines
# written between the copy and the truncate are lost -- which is a few records once a day
# against silently losing whole runs.
#
# `su` is required because the log lives in a group-writable home directory; logrotate
# refuses to rotate such a directory otherwise.

/opt/careerradar/app.log {
    su careerradar careerradar
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
