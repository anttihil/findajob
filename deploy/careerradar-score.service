[Unit]
Description=CareerRadar scoring: judge unscored postings against the profile
Documentation=file:///opt/careerradar/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

User=careerradar
Group=careerradar

WorkingDirectory=/opt/careerradar
ExecStart=/opt/careerradar/.venv/bin/careerradar score run

# One API call per posting at ~8-way concurrency. A normal incremental run is a few
# hundred postings and finishes in minutes; the ceiling covers a first pass over a cold
# backlog without being generous enough to hide a wedged run.
TimeoutStartSec=90min

# Unlike the scraper, this one MAY retry: it talks to an API with its own rate-limit
# semantics, not to a board that will treat a retry as abuse. A failed posting keeps
# pipeline_state='new' and is simply picked up again, so a retry costs nothing and loses
# nothing.
Restart=on-failure
RestartSec=120s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=careerradar-score

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/opt/careerradar
